# Copy to .env (gitignored). Every script loads it through scripts/lib/env.ts.

# Studio-scoped ElevenLabs key (Settings > API Keys). NOT the app's voice-agent key:
# a video batch must never spend the credits the live app depends on.
# Scope: text-to-speech, sound effects. Set a credit cap on the key.
ELEVENLABS_API_KEY=

# The English narrator voice (Voice Library voice id), picked blind from the
# listen set (docs/voice-guide.md records the pick).
ELEVENLABS_VOICE_ID=

# Pinned pronunciation dictionary (created by `npm run voice:dictionaries`).
ELEVENLABS_DICTIONARY_ID=
ELEVENLABS_DICTIONARY_VERSION_ID=

# Where footage, recordings, voice takes and renders live: the external SSD.
# The repo's ./media symlink points here (`npm run media:setup`).
MEDIA_ROOT=/Volumes/SkanyxMedia/studio

# The two sibling repos the studio reads facts and recordings from.
WEB_REPO=/Users/kviksva/CortexAutoWeb
APP_REPO=/Users/kviksva/car_health_ai
